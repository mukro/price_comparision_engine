# ==============================================================================
# Price Comparison Engine — Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ==============================================================================

# ==============================================================================
# 1. DATABASE (PostgreSQL + pgvector)
# ==============================================================================
POSTGRES_USER=price_engine
POSTGRES_PASSWORD=change_this_to_a_very_strong_password_32chars
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=price_comparison

# ==============================================================================
# 2. REDIS (Cache, Celery Broker, Rate Limiting)
# ==============================================================================
REDIS_URL=redis://:change_this_redis_password@redis:6379/0
REDIS_PASSWORD=change_this_redis_password

# ==============================================================================
# 3. AUTHENTICATION (JWT)
# ==============================================================================
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET_KEY=your_super_secret_jwt_key_min_32_chars_long_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ==============================================================================
# 4. ADMIN CREDENTIALS
# ==============================================================================
# Default admin login for /admin/* endpoints
# Generate bcrypt hash: python -c "from passlib.hash import bcrypt; print(bcrypt.hash('yourpassword'))"
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD_HASH=$2b$12$EixZaYVK1fsbw1ZfbX3OXePaWxn96p36WQoeG6Lruj3vjPGga31lW

# ==============================================================================
# 5. EMAIL (SendGrid)
# ==============================================================================
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
FROM_EMAIL=alerts@yourdomain.com

# ==============================================================================
# 6. PUSH NOTIFICATIONS (Firebase Cloud Messaging)
# ==============================================================================
# Get your server key from Firebase Console → Project Settings → Cloud Messaging
FCM_SERVER_KEY=your_fcm_server_key_here
# Or use service account JSON for HTTP v1 API:
# GOOGLE_APPLICATION_CREDENTIALS=/app/service-account.json

# ==============================================================================
# 7. CORS (Frontend Origins)
# ==============================================================================
# Comma-separated list of allowed origins
# For Flutter app, use your production API domain + local dev
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,https://yourdomain.com

# ==============================================================================
# 8. SCRAPING COMPLIANCE
# ==============================================================================
SCRAPING_ENABLED=true
DEFAULT_SCRAPE_RPM=6
ENFORCE_ROBOTS_TXT=true
ENFORCE_DOMAIN_ALLOWLIST=false
SCRAPER_USER_AGENT=Mozilla/5.0 (compatible; PriceComparisonBot/1.0; +https://yourdomain.com/bot)
SCRAPER_PROXY_URL=
BROWSER_MAX_PAGES=4
SCRAPER_TIMEOUT_MS=15000

# ==============================================================================
# 9. MONITORING & OPS
# ==============================================================================
GRAFANA_ADMIN_PASSWORD=change_this_grafana_password
FLOWER_USER=admin
FLOWER_PASSWORD=change_this_flower_password

# ==============================================================================
# 10. AFFILIATE & MERCHANT SETTINGS
# ==============================================================================
# Default commission rate you charge merchants (percentage)
DEFAULT_COMMISSION_RATE_PCT=2.5
# Click attribution window in hours (how long after click we count a conversion)
CLICK_ATTRIBUTION_WINDOW_HOURS=168
# Minimum wallet balance multiplier for creating sponsored placements (3x daily budget)
SPONSORED_MIN_BALANCE_MULTIPLIER=3

# ==============================================================================
# 11. PARTNER FEED API
# ==============================================================================
# Max products per feed request
PARTNER_FEED_MAX_BATCH_SIZE=1000
# Default rate limit for partner API keys (requests per minute)
PARTNER_DEFAULT_RATE_LIMIT_RPM=60
# ==============================================================================
# 11. Data QUALITY AGENT
# ==============================================================================
OPENAI_API_KEY