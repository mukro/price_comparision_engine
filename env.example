# ==========================================
# Price Comparison Engine — Environment
# ==========================================

# --- PostgreSQL ---
POSTGRES_USER=price_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=price_comparison

# --- Redis ---
REDIS_URL=redis://:change_me_in_production@redis:6379/0
REDIS_PASSWORD=change_me_in_production

# --- JWT ---
JWT_SECRET_KEY=replace_with_64_char_random_string_min_length_32_chars_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Email ---
SENDGRID_API_KEY=
FROM_EMAIL=alerts@pricecomparison.com

# --- Razorpay (AutoBuy payments) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Firebase Cloud Messaging (push notifications) ---
FCM_SERVER_KEY=
FCM_PROJECT_ID=

# --- Agentic AI ---
AGENTS_ENABLED=false

# --- Scraping Governance ---
SCRAPING_ENABLED=true
DEFAULT_SCRAPE_RPM=6
ENFORCE_ROBOTS_TXT=true
ENFORCE_DOMAIN_ALLOWLIST=false
SCRAPER_USER_AGENT="Mozilla/5.0 (compatible; PriceComparisonBot/1.0; +https://example.com/bot)"
SCRAPER_PROXY_URL=
BROWSER_MAX_PAGES=4
SCRAPER_TIMEOUT_MS=15000

# --- Monitoring ---
FLOWER_USER=admin
FLOWER_PASSWORD=admin

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=admin
